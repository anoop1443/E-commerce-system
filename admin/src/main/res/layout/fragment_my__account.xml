<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.profile.My_AccountFragment">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/profile_item_layou"
                android:id="@+id/profileDetails">
            </include>

            <include
                android:id="@+id/order_Details"
                layout="@layout/order_status_layout"
                android:visibility="gone">

            </include>

            <include
                android:id="@+id/order_recent_Details"
                layout="@layout/your_recent_order_layout"
                android:visibility="gone">


            </include>

            <include layout="@layout/my_addres_layout"
                android:id="@+id/address_Details">
            </include>


            <Button
                android:id="@+id/my_account_sign_out_btn"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="40dp"
                android:text="sign out"
                style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton.Icon"
                android:gravity="center"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>
</FrameLayout>