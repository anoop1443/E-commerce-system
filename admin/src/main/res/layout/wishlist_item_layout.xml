<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@color/white"
    android:elevation="5dp">

    <ImageView
        android:id="@+id/wishlist_product_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@drawable/tebal_fan" />

    <TextView
        android:id="@+id/wishlist_product_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="This is a very long product title that should wrap to the next line"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/wishlist_delete_btn"
        app:layout_constraintStart_toEndOf="@+id/wishlist_product_image"
        app:layout_constraintTop_toTopOf="@+id/wishlist_product_image" />


    <LinearLayout
        android:id="@+id/rating_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/round_backgroud"
        android:backgroundTint="#DD08CC08"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        app:layout_constraintStart_toStartOf="@+id/wishlist_product_title"
        app:layout_constraintTop_toBottomOf="@+id/wishlist_coupen_title">

        <TextView
            android:id="@+id/product_images_layout_wishlist_StarRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.5"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="3dp"
            android:src="@android:drawable/btn_star_big_on"
            app:tint="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/wishlist_total_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="(2,789 Ratings)"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/rating_container"
        app:layout_constraintStart_toEndOf="@+id/rating_container"
        app:layout_constraintTop_toTopOf="@+id/rating_container" />


    <LinearLayout
        android:id="@+id/price_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@+id/wishlist_product_title"
        app:layout_constraintTop_toBottomOf="@+id/rating_container">

        <TextView
            android:id="@+id/wishlist_product_prise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs. 4,399"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wishlist_product_cat_prise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/strike_through"
            android:text="Rs. 5,999"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wishlist_percentOF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="25% OFF"
            android:textColor="@color/green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>




    <TextView
        android:id="@+id/wishlist_coupen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawableStart="@drawable/discount_coupan24"
        android:drawablePadding="4dp"
        android:drawableTint="#023178"
        android:gravity="center_vertical"
        android:text="Free 1 Coupon"
        android:textColor="#023178"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/wishlist_product_title"
        app:layout_constraintTop_toBottomOf="@+id/wishlist_product_title" />


    <ImageButton
        android:id="@+id/wishlist_delete_btn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:contentDescription="Remover Wishlist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wishlist_product_title"
        app:srcCompat="@drawable/ic_delete_24" />

    <TextView
        android:id="@+id/wishlist_payment_mathod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="Cash on delivery available"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/wishlist_product_title"
        app:layout_constraintTop_toBottomOf="@+id/price_container" />


</androidx.constraintlayout.widget.ConstraintLayout>
