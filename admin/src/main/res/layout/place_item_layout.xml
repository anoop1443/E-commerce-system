<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_margin="2dp"
    android:background="@drawable/round_backgroud"

    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/place_product_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/tebal_fan" />

    <TextView
        android:id="@+id/place_product_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Canon EOS 3000D "
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/place_product_image"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/place_title_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="5dp"
        android:text="Black"
        android:textSize="10sp"
        app:layout_constraintStart_toEndOf="@+id/place_product_image"
        app:layout_constraintTop_toBottomOf="@+id/place_product_title" />

    <LinearLayout
        android:id="@+id/rate_now_contenr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toEndOf="@+id/place_product_image"
        app:layout_constraintTop_toBottomOf="@+id/place_title_body">

        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:elevation="5dp"
            app:srcCompat="@drawable/star_rating" />

        <ImageView
            android:id="@+id/imageView7"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:elevation="5dp"
            app:srcCompat="@drawable/star_rate"
            app:tint="#BBBDBB" />

        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"

            android:elevation="5dp"
            app:srcCompat="@drawable/star_rate"
            app:tint="#BBBDBB" />

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:elevation="5dp"
            app:srcCompat="@drawable/star_rate"
            app:tint="#BBBDBB" />

        <ImageView
            android:id="@+id/imageView10"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:elevation="5dp"
            app:srcCompat="@drawable/star_rate"
            app:tint="#BBBDBB" />
    </LinearLayout>

    <TextView
        android:id="@+id/place_total_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="(45.87k)"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/rate_now_contenr"
        app:layout_constraintStart_toEndOf="@+id/rate_now_contenr"
        app:layout_constraintTop_toTopOf="@+id/rate_now_contenr" />

    <TextView
        android:id="@+id/place_product_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rond_set"
        android:backgroundTint="#000000"
        android:drawableEnd="@drawable/ic_arrow_drop_down"
        android:gravity="left"
        android:padding="8dp"
        android:text="Qty: 1"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/place_product_image" />

    <TextView
        android:id="@+id/place_cat_prise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="₹599"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/place_product_image"
        app:layout_constraintTop_toBottomOf="@+id/rate_now_contenr" />

    <TextView
        android:id="@+id/place_Prise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="₹219"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/place_cat_prise"
        app:layout_constraintStart_toEndOf="@+id/place_cat_prise"
        app:layout_constraintTop_toTopOf="@+id/place_cat_prise" />

    <TextView
        android:id="@+id/place_off"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="63%of"
        android:textColor="@color/green"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/place_Prise"
        app:layout_constraintStart_toEndOf="@+id/place_Prise"
        app:layout_constraintTop_toTopOf="@+id/place_Prise" />

    <TextView
        android:id="@+id/place_offers_applied"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="2 offers applied "
        android:textColor="@color/green"
        app:layout_constraintStart_toEndOf="@+id/place_product_image"
        app:layout_constraintTop_toBottomOf="@+id/place_cat_prise" />


    <TextView
        android:id="@+id/place_offers_available"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:text="2 offers available "
        android:textColor="@color/green"
        app:layout_constraintBottom_toBottomOf="@+id/place_offers_applied"
        app:layout_constraintStart_toEndOf="@+id/place_offers_applied"
        app:layout_constraintTop_toTopOf="@+id/place_offers_applied"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/place_work_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"
        android:text="Work by Fri Sep 3"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/place_product_qty" />

    <View
        android:id="@+id/divider5"
        android:layout_width="1dp"
        android:layout_height="25dp"
        android:layout_marginStart="8dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toBottomOf="@+id/place_service_charge"
        app:layout_constraintStart_toEndOf="@+id/place_work_day"
        app:layout_constraintTop_toTopOf="@+id/place_service_charge" />

    <TextView
        android:id="@+id/place_service_charge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Service Charge"
        android:textColor="#3CBA0F"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/place_work_day"
        app:layout_constraintStart_toEndOf="@+id/divider5"
        app:layout_constraintTop_toTopOf="@+id/place_work_day" />

    <TextView
        android:id="@+id/place_service_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Rs 200"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/place_service_charge"
        app:layout_constraintStart_toEndOf="@+id/place_service_charge"
        app:layout_constraintTop_toTopOf="@+id/place_service_charge" />

    <View
        android:id="@+id/divider14"
        android:layout_width="0dp"
        android:layout_height="1dp"

        android:background="#BBBDBB"


        app:layout_constraintBottom_toBottomOf="@+id/place_cat_prise"
        app:layout_constraintEnd_toEndOf="@+id/place_cat_prise"
        app:layout_constraintStart_toStartOf="@+id/place_cat_prise"
        app:layout_constraintTop_toTopOf="@+id/place_cat_prise" />


</androidx.constraintlayout.widget.ConstraintLayout>