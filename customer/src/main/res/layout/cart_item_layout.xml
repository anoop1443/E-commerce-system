<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cart_itme_constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/cart_product_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/tebal_fan" />

        <!-- Product Title -->
        <TextView
            android:id="@+id/cart_product_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Table Fan (White)"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cart_product_image"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Price Section -->
        <LinearLayout
            android:id="@+id/price_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/cart_product_title"
            app:layout_constraintTop_toBottomOf="@+id/cart_product_title">

            <TextView
                android:id="@+id/cart_product_prise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs.4599"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cart_product_cut_prise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="RS.4799"
                android:textColor="#888888"
                android:textSize="13sp" />

            <!-- Strike-through View -->
            <View
                android:id="@+id/cart_item_divider4"
                android:layout_width="45dp"
                android:layout_height="1dp"
                android:background="#888888"
                android:translationX="-42dp" />
            <!-- Note: translationX is a bit hacky, but keeping your original view logic for strike-thru -->
        </LinearLayout>

        <TextView
            android:id="@+id/cart_coupon_offers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1 coupon &amp; 2 offers applied"
            android:textColor="#388E3C"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/cart_product_title"
            app:layout_constraintTop_toBottomOf="@+id/price_container" />

        <!-- Quantity Selector Look -->
        <TextView
            android:id="@+id/cart_product_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rond_set"
            android:backgroundTint="#F5F5F5"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawablePadding="4dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Qty: 1"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cart_product_image" />

        <!-- Work/Delivery Info -->
        <TextView
            android:id="@+id/place_work_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Delivery by Fri, Sep 3"
            android:textColor="#666666"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/cart_product_qty"
            app:layout_constraintStart_toEndOf="@+id/cart_product_qty"
            app:layout_constraintTop_toTopOf="@+id/cart_product_qty" />

        <!-- Service Charge Info -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/place_work_day">

            <TextView
                android:id="@+id/place_service_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Service: "
                android:textColor="#388E3C"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/place_service_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs 200"
                android:textColor="#388E3C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/divider9"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#EEEEEE"
            app:layout_constraintTop_toBottomOf="@+id/cart_product_qty" />

        <!-- Bottom Actions -->
        <LinearLayout
            android:id="@+id/linearLayout6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/divider9">

            <TextView
                android:id="@+id/cart_item_remove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:drawableStart="@drawable/ic_delete_24"
                android:drawablePadding="8dp"
                android:paddingVertical="8dp"
                android:text="Remove Item"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#EEEEEE" />

            <Button
                android:id="@+id/cart_item_buy_bt"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save for later"
                android:textColor="#1976D2"
                android:visibility="gone" />
            <!-- Note: Buy this now was gone, keeping layout logic but naming it "Save for later" for standard look -->

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
