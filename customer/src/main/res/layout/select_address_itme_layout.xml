<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_margin="4dp"
        android:padding="12dp">

        <RadioButton
            android:id="@+id/radio1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@+id/select_address_itme_Name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/select_address_itme_Name" />

        <TextView
            android:id="@+id/select_address_itme_Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Anoop Kumar"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintStart_toEndOf="@+id/radio1"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/textView18"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F0F0F0"
            android:clickable="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp"
            android:text="HOME"
            android:textColor="#666666"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/select_address_itme_Name"
            app:layout_constraintStart_toEndOf="@+id/select_address_itme_Name"
            app:layout_constraintTop_toTopOf="@+id/select_address_itme_Name" />

        <ImageView
            android:id="@+id/select_address_itme_opstion_manu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:src="@drawable/more_vert_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#888888" />

        <TextView
            android:id="@+id/select_address_itme_fullAddres"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:lineSpacingExtra="2dp"
            android:text="#13 gangan (Avatar election) bachauli auras unnao,Hasanganj,avatar election,hyderabad,uttar pradesh - 209870"
            android:textColor="#555555"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/select_address_itme_Name"
            app:layout_constraintTop_toBottomOf="@+id/select_address_itme_Name" />

        <TextView
            android:id="@+id/select_address_itme_phoneNu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="8288943143"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/select_address_itme_fullAddres"
            app:layout_constraintTop_toBottomOf="@+id/select_address_itme_fullAddres" />

        <!-- Floating Options Menu -->
        <LinearLayout
            android:id="@+id/select_address_itme_linerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/cardview_dark_background"
            android:backgroundTint="@color/white"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="4dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/select_address_itme_opstion_manu">

            <TextView
                android:id="@+id/select_address_itme_linearLayout_Edit"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp"
                android:text="Edit"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <TextView
                android:id="@+id/select_address_itme_linearLayout_Remove"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="10dp"
                android:text="Remove"
                android:textColor="#F44336"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Hidden Edit Button (Preserved ID) -->
        <Button
            android:id="@+id/select_address_itme_editBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
